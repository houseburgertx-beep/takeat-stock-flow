# ==============================================================================
# CONFIGURAÇÃO DE INTEGRAÇÃO - TAKEA T API V1.0
# ==============================================================================
# Obtenha sua API Key no AI Builders: https://ai-builders.takeat.app
#
# Para testes: use uma chave com prefixo 'tk_test_...'
# Para produção: use uma chave com prefixo 'tk_live_...'
#
# Escopos necessários no AI Builders:
# - inputs:read          (Consultar insumos e posição de estoque)
# - products:read        (Consultar catálogo de produtos)
# - complements:read     (Consultar catálogo de complementos)
# - table-sessions:read  (Consultar comandas e pedidos finalizados)
# ==============================================================================

# Sua chave gerada no AI Builders (NUNCA compartilhe nem comite este valor)
TAKEAT_API_KEY=tk_test_seu_token_aqui

# URL base da Nova API Takeat (padrão oficial)
TAKEAT_API_URL=https://public-api.takeat.app

# ID do restaurante (necessário apenas para contas de parceiro multi-restaurante)
# Para chaves de restaurante único, pode deixar vazio (é inferido automaticamente)
TAKEAT_RESTAURANT_ID=

# ==============================================================================
# CONFIGURAÇÃO DO SERVIDOR LOCAL E ESTOQUE
# ==============================================================================
PORT=3000
DATABASE_PATH=./data/estoque.db

# Intervalo automático de verificação de vendas (em minutos, 0 para desativar)
AUTO_TRACK_INTERVAL_MINUTES=5
